{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "seed": "tsx scripts/seed.ts",
    "generate": "tsx scripts/generate-assets.ts",
    "seed:academies": "tsx scripts/generate-real-bjj-seed.ts",
    "test": "vitest run"
  },
