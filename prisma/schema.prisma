datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS FOR GAMIFIED BJJ PLATFORM
// ==========================================

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

// ==========================================
// CORE DOMAIN MODELS
// ==========================================

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  name              String
  password          String
  isEmailVerified   Boolean   @default(false)
  verificationToken String?
  resetToken        String?
  resetTokenExpires DateTime?
  refreshToken      String?
  avatar            String?
  role              String    @default("ATHLETE")
  isAdminApproved   Boolean   @default(true)
  isSuspended       Boolean   @default(false)
  isBanned          Boolean   @default(false)
  belt              String    @default("WHITE")
  stripes           Int       @default(0)
  xp                Int       @default(0)
  level             Int       @default(1)
  elo               Int       @default(1000)
  bio               String?   @default("")
  city              String?   @default("")
  country           String?   @default("")
  nativeLanguage    String?   @default("")
  learningGoal      String?   @default("")
  profilePhoto      String?   @default("")
  coverPhoto        String?   @default("")
  instagram         String?   @default("")
  youtube           String?   @default("")
  facebook          String?   @default("")
  website           String?   @default("")
  birthDate         DateTime?
  phone             String?
  englishLevel      String?
  spanishLevel      String?
  frenchLevel       String?
  onboardingDone    Boolean   @default(false)
  lastLoginAt       DateTime?
  username          String?   @unique
  beltRank          String?
  favoriteTechnique String?
  favoriteAthlete   String?
  privacyLevel      String?   @default("public")
  followersCount    Int       @default(0)
  followingCount    Int       @default(0)
  themeColor        String?
  avatarFrame       String?
  isVerified        Boolean   @default(false)
  vipActive         Boolean   @default(false)
  masterActive      Boolean   @default(false)
  subscriptionType  String?   @default("FREE")
  subscriptionUntil DateTime?
  aiConversationExpiresAt DateTime?
  isMuted           Boolean   @default(false)
  isFrozen          Boolean   @default(false)
  deletedAt         DateTime?
  deletedBy         String?
  deleteReason      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relationships
  wallet                  Wallet?
  bankAccounts            BankAccount[]
  subscriptions           Subscription[]
  payments                Payment[]
  userAchievements        UserAchievement[]
  inventory               Inventory?
  storeSales              StoreSale[]
  marketplaceSalesAsBuyer MarketplaceSale[]
  marketplaceItemsForSale MarketplaceItem[]
  pvpMatchesAsChallenger  PvpMatch[]        @relation("ChallengerMatches")
  pvpMatchesAsDefender    PvpMatch[]        @relation("DefenderMatches")
  pvpMatchesAsWinner      PvpMatch[]        @relation("WinnerMatches")
  pvpAnswers              PvpAnswer[]
  rank                    Rank?
  notifications           Notification[]
  auditLogs               AuditLog[]
  financialLogs           FinancialLog[]
  socialPosts             SocialPost[]
  comments                Comment[]
  likes                   Like[]
  followers               Follower[]        @relation("UserFollowers")
  following               Follower[]        @relation("UserFollowing")
  refreshTokens           RefreshToken[]
  academyProgress         AcademyProgress[]
  courseModuleProgress    CourseModuleProgress[]
  courseLessonProgress    CourseLessonProgress[]
  courseExamAttempts      CourseExamAttempt[]
  examAttempts            ExamAttempt[]
  paymentTransactions     PaymentTransaction[]

  // Marketplace Domain Virtual Relations (Additive, no physical User columns added)
  teacherProfile         TeacherProfile?
  teacherApplications    MarketplaceTeacherApplication[]
  marketplacePurchases   MarketplacePurchase[]
  marketplaceEnrollments MarketplaceEnrollment[]
  marketplaceReviews     MarketplaceReview[]
  affiliationHistories   AffiliationHistory[]
  governanceAuditLogs    GovernanceAuditLog[]

  globalTeamId            String?
  branchId                String?
  independentAcademyId    String?

  globalTeam              GlobalTeam?         @relation(fields: [globalTeamId], references: [id], onDelete: SetNull)
  branch                  AcademyBranch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  independentAcademy      IndependentAcademy? @relation(fields: [independentAcademyId], references: [id], onDelete: SetNull)

  @@index([belt])
  @@index([level])
  @@index([elo])
  @@index([globalTeamId])
  @@index([branchId])
  @@index([independentAcademyId])
}

model Wallet {
  id               String   @id @default(uuid())
  userId           String   @unique
  balanceJT        Int      @default(0) // JiuTickets (Platform virtual coin)
  balanceBRL       Decimal  @default(0.00) // Instructor/Saas real monetary balance
  balanceAvailable Decimal  @default(0.00) // Saldo disponível para saque
  balancePending   Decimal  @default(0.00) // Saldo pendente (vendas aprovadas)
  totalEarned      Decimal  @default(0.00) // Total ganho acumulado
  totalWithdrawn   Decimal  @default(0.00) // Total sacado acumulado
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relationships
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  withdrawals  Withdrawal[]
}

model Transaction {
  id          String   @id @default(uuid())
  walletId    String
  amountJT    Int?
  amountBRL   Decimal?
  type        String
  status      String   @default("PENDING")
  description String?
  referenceId String? // Tracking code linked to Purchases (StoreSale, P2PSale ID)
  createdAt   DateTime @default(now())

  // Relationships
  wallet     Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  pixPayment PixPayment?

  @@index([walletId, status])
  @@index([type])
  @@index([referenceId])
  @@index([createdAt])
}

model PixPayment {
  id              String    @id @default(uuid())
  transactionId   String    @unique
  qrCode          String
  qrCodeCopyPaste String
  txid            String    @unique
  amountBRL       Decimal
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  paidAt          DateTime?

  // Relationships
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
}

model BankAccount {
  id            String   @id @default(uuid())
  userId        String
  bankName      String
  agency        String
  accountNumber String
  accountType   String // Corrente, Poupança, etc.
  pixKey        String?
  pixKeyType    String?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relationships
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawals Withdrawal[]

  @@index([userId])
}

model Withdrawal {
  id            String   @id @default(uuid())
  walletId      String
  bankAccountId String
  amountBRL     Decimal
  status        String   @default("PENDING")
  pixKey        String
  pixKeyType    String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relationships
  wallet      Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  @@index([walletId])
  @@index([bankAccountId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

model WithdrawalAudit {
  id           String   @id @default(uuid())
  withdrawalId String
  action       String // REQUEST, BLOCKED_BALANCE, ADMIN_APPROVE, PIX_DISPATCHED, ADMIN_REJECT, RESTORED_BALANCE
  actorId      String?
  actorName    String?
  details      String
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([withdrawalId])
  @@index([actorId])
  @@index([createdAt])
}

model Subscription {
  id         String    @id @default(uuid())
  userId     String
  planId     String
  planType   String? // PRO, MASTER, etc.
  provider   String? // STRIPE, MERCADOPAGO, FREE
  externalId String? // Stripe subscription ID or checkout session ID
  amount     Decimal?
  status     String    @default("ACTIVE")
  startDate  DateTime  @default(now())
  endDate    DateTime
  canceledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relationships
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments SubscriptionPayment[]

  @@index([userId])
  @@index([planId])
  @@index([userId, status])
  @@index([status, endDate])
}

model Payment {
  id             String   @id @default(uuid())
  userId         String
  subscriptionId String
  provider       String
  status         String
  amount         Decimal
  currency       String
  transactionId  String   @unique
  payerEmail     String?
  payerName      String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subscriptionId])
  @@index([transactionId])
}

model PaymentLog {
  id            String   @id @default(uuid())
  provider      String?
  transactionId String?
  status        String?
  amount        Decimal?
  payerEmail    String?
  payerName     String?
  createdAt     DateTime @default(now())
}

model WebhookLog {
  id            String   @id @default(uuid())
  provider      String?
  transactionId String?
  status        String?
  amount        Decimal?
  payerEmail    String?
  payerName     String?
  payload       String?
  createdAt     DateTime @default(now())
}

model Plan {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  priceBRL    Decimal
  interval    String // monthly, yearly
  features    String[]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Relationships
  subscriptions Subscription[]

  @@index([active])
}

model SubscriptionPayment {
  id              String    @id @default(uuid())
  subscriptionId  String
  amountBRL       Decimal
  status          String    @default("PENDING")
  txid            String?   @unique
  qrCode          String?
  qrCodeCopyPaste String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relationships
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@index([subscriptionId, status])
}

model Achievement {
  id              String   @id @default(uuid())
  title           String   @unique
  description     String
  xpReward        Int
  coinReward      Int
  requirementCode String   @unique // Internal programmatic check name (e.g., 'LessonsCompleted')
  targetValue     Int // Numerical threshold to lock/unlock
  imageUrl        String?
  createdAt       DateTime @default(now())

  // Relationships
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String    @id @default(uuid())
  userId        String
  achievementId String
  currentValue  Int       @default(0)
  isUnlocked    Boolean   @default(false)
  unlockedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([achievementId])
  @@index([isUnlocked])
}

model Inventory {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items InventoryItem[]
}

model InventoryItem {
  id          String   @id @default(uuid())
  inventoryId String
  productId   String? // References official catalog product, nullable if custom listing/drop
  name        String
  description String?
  rarity      Rarity   @default(COMMON)
  imageUrl    String?
  isEquipped  Boolean  @default(false)
  acquiredAt  DateTime @default(now())

  // Relationships
  inventory       Inventory        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  product         StoreProduct?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  marketplaceItem MarketplaceItem?

  @@index([inventoryId])
  @@index([productId])
  @@index([inventoryId, isEquipped])
}

model StoreProduct {
  id           String    @id @default(uuid())
  name         String    @unique
  description  String
  priceJT      Int
  priceBRL     Decimal? // Optional fiat pricing for premium cosmetics
  category     String // GI, BELT_STRIPE, AVATAR, TITLE_TAG
  rarity       Rarity    @default(COMMON)
  imageUrl     String?
  stock        Int? // Null means infinite stock
  active       Boolean   @default(true)
  isPromo      Boolean   @default(false)
  promoPriceJT Int?
  isBundle     Boolean   @default(false)
  isSeasonal   Boolean   @default(false)
  isExclusive  Boolean   @default(false)
  releaseDate  DateTime? // Programmed launch date/time
  promoEndDate DateTime? // Programmed promotion end date/time
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relationships
  storeSales     StoreSale[]
  inventoryItems InventoryItem[]

  @@index([category])
  @@index([active, category])
}

model StoreSale {
  id           String   @id @default(uuid())
  productId    String
  buyerId      String
  pricePaidJT  Int?
  pricePaidBRL Decimal?
  createdAt    DateTime @default(now())

  // Relationships
  product StoreProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  buyer   User         @relation(fields: [buyerId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([buyerId])
}

model MarketplaceItem {
  id              String   @id @default(uuid())
  inventoryItemId String   @unique
  sellerId        String
  priceJT         Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  inventoryItem InventoryItem    @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  seller        User             @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  sale          MarketplaceSale?

  @@index([sellerId])
  @@index([active])
  @@index([active, priceJT])
  @@index([active, createdAt])
}

model MarketplaceSale {
  id                String   @id @default(uuid())
  marketplaceItemId String   @unique
  buyerId           String
  pricePaidJT       Int
  feePaidJT         Int // Platform fee collected from transit
  createdAt         DateTime @default(now())

  // Relationships
  marketplaceItem MarketplaceItem @relation(fields: [marketplaceItemId], references: [id], onDelete: Cascade)
  buyer           User            @relation(fields: [buyerId], references: [id], onDelete: Restrict)

  @@index([buyerId])
}

model PvpMatch {
  id                  String   @id @default(uuid())
  challengerId        String
  defenderId          String
  winnerId            String?
  challengerScore     Int      @default(0)
  defenderScore       Int      @default(0)
  xpReward            Int      @default(0)
  coinReward          Int      @default(0)
  eloChangeChallenger Int?
  eloChangeDefender   Int?
  status              String   @default("PENDING")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relationships
  challenger User       @relation("ChallengerMatches", fields: [challengerId], references: [id], onDelete: Cascade)
  defender   User       @relation("DefenderMatches", fields: [defenderId], references: [id], onDelete: Cascade)
  winner     User?      @relation("WinnerMatches", fields: [winnerId], references: [id], onDelete: SetNull)
  rounds     PvpRound[]

  @@index([challengerId])
  @@index([defenderId])
  @@index([winnerId])
  @@index([status])
}

model PvpRound {
  id          String   @id @default(uuid())
  matchId     String
  roundNumber Int
  questionId  String
  createdAt   DateTime @default(now())

  // Relationships
  match    PvpMatch    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  question PvpQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answers  PvpAnswer[]

  @@unique([matchId, roundNumber])
  @@index([questionId])
}

model PvpQuestion {
  id            String   @id @default(uuid())
  text          String
  category      String
  difficulty    String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String // "A", "B", "C" or "D"
  explanation   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  // Relationships
  pvpRounds  PvpRound[]
  pvpAnswers PvpAnswer[]

  @@index([category])
  @@index([category, isActive])
}

model PvpAnswer {
  id             String   @id @default(uuid())
  roundId        String
  userId         String
  questionId     String
  selectedOption String
  isCorrect      Boolean
  responseTimeMs Int
  createdAt      DateTime @default(now())

  // Relationships
  round    PvpRound    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  question PvpQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
  @@index([userId])
  @@index([questionId])
}

model Rank {
  id             String   @id @default(uuid())
  userId         String   @unique
  globalPosition Int?
  beltPosition   Int?
  weeklyRank     String   @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM, CHAMPION
  points         Int      @default(0)
  updatedAt      DateTime @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([points])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  type      String   @default("SYSTEM")
  isRead    Boolean  @default(false)
  linkTo    String? // Redirection link within the platform
  createdAt DateTime @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  action      String
  description String
  ipAddress   String?
  userAgent   String?
  amountBRL   Decimal?
  amountJT    Int?
  createdAt   DateTime @default(now())

  // Relationships
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model FinancialLog {
  id                String   @id @default(uuid())
  userId            String?
  walletId          String?
  type              String   // e.g., "DEPOSIT", "WITHDRAWAL", "COMMISSION", "REFUND", "TRANSFER", "PURCHASE"
  amountBRL         Decimal?
  amountJT          Int?
  balanceBRLBefore  Decimal?
  balanceBRLAfter   Decimal?
  balanceJTBefore   Int?
  balanceJTAfter    Int?
  status            String   // e.g., "PENDING", "COMPLETED", "FAILED"
  description       String
  transactionId     String?
  createdAt         DateTime @default(now())

  // Relationships
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model SocialPost {
  id           String   @id @default(uuid())
  authorId     String
  content      String
  category     String // "#treinos", "#duvidas-posicoes", "#memes-tatame", "#campeonatos"
  imageUrl     String?
  videoUrl     String?
  upvotesCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]

  @@index([authorId])
  @@index([category])
  @@index([createdAt])
  @@index([category, createdAt])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  post   SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  // Relationships
  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Follower {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  // Relationships
  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  issuedAt   DateTime @default(now())
  isRevoked  Boolean  @default(false)
  ipAddress  String?
  userAgent  String?
  replacedBy String? // Stores the newer token in the rotation chain

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ipAddress String?
  success   Boolean
  timestamp DateTime @default(now())

  @@index([email])
  @@index([timestamp])
  @@index([email, success, timestamp])
}

model AcademyModule {
  id          String          @id @default(cuid())
  title       String
  description String
  beltLevel   String
  orderIndex  Int
  active      Boolean         @default(true)
  lessons     AcademyLesson[]
}

model AcademyLesson {
  id          String @id @default(cuid())
  moduleId    String
  title       String
  description String
  youtubeUrl  String
  pdfUrl      String?
  audioUrl    String?
  attachments String?
  exercises   String?
  xpReward    Int    @default(100)
  orderIndex  Int

  module AcademyModule @relation(fields: [moduleId], references: [id])
}

model AcademyProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id])
}

model AcademyExam {
  id              String         @id @default(cuid())
  moduleId        String         @unique
  title           String
  minPassingGrade Float          @default(70.0)
  maxAttempts     Int            @default(3)
  questions       ExamQuestion[]
  attempts        ExamAttempt[]
}

model ExamQuestion {
  id            String      @id @default(cuid())
  examId        String
  questionText  String
  options       String[]
  correctAnswer String
  exam          AcademyExam @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model ExamAttempt {
  id          String      @id @default(cuid())
  examId      String
  userId      String
  score       Float
  passed      Boolean
  attemptedAt DateTime    @default(now())
  exam        AcademyExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([examId])
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  ipAddress    String?
  deviceInfo   String?
  userAgent    String?
  lastSeen     DateTime @default(now())
  currentPage  String?
  isOnline     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([isOnline])
}

model UserModeration {
  id             String    @id @default(uuid())
  userId         String
  moderationType String    // SUSPENSION, BAN, MUTE, FREEZE
  reason         String
  expiresAt      DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())

  @@index([userId])
}

model AdminAuditLog {
  id            String   @id @default(uuid())
  adminId       String
  targetUserId  String?
  actionType    String
  actionDetails String
  createdAt     DateTime @default(now())

  @@index([adminId])
  @@index([targetUserId])
}

model AdminRole {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[]
}

model PaymentTransaction {
  id                String   @id @default(cuid())
  userId            String
  mercadoPagoId     String   @unique
  amountBRL         Float
  amountJT          Int
  status            String
  paymentMethod     String
  qrCode            String?
  qrCodeBase64      String?
  copiaecola        String?
  processed         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model UserProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  bio           String?
  country       String?
  city          String?
  academy       String?
  bjjInstagram  String?
  bjjYoutube    String?
  bjjTikTok     String?
  teacherBadge  Boolean  @default(false)
  athleteBadge  Boolean  @default(false)
  verifiedBadge Boolean  @default(false)
  createdAt     DateTime @default(now())
}


model SocialFeed {
  id          String   @id @default(uuid())
  userId      String
  type        String   // "ACHIEVEMENT", "CERTIFICATE", "XP_GAIN", "PVP_VICTORY", "BELT_PROMOTION"
  title       String
  content     String
  createdAt   DateTime @default(now())
}

model SocialShare {
  id          String   @id @default(uuid())
  userId      String
  postType    String   // "ACHIEVEMENT", "CERTIFICATE", "BELT_PROMOTION"
  itemId      String
  platform    String   // "INSTAGRAM", "WHATSAPP", "TIKTOK", "LINK_COPY"
  createdAt   DateTime @default(now())
}

model Certificate {
  id          String   @id @default(uuid())
  userId      String
  moduleTitle String
  beltLevel   String
  hash        String   @unique
  qrCode      String
  createdAt   DateTime @default(now())
}

model UserReferral {
  id           String   @id @default(uuid())
  referrerId   String
  referredId   String   @unique
  referralCode String
  rewardAmount Int      @default(100) // JiuTickets rewards
  createdAt    DateTime @default(now())
}

model UserActivityLog {
  id          String   @id @default(uuid())
  userId      String
  actionType  String   // "FOLLOW", "POST_CREATION", "CERTIFICATE_VIEW", "PROFILE_EDIT"
  description String
  ipAddress   String?
  createdAt   DateTime @default(now())
}

// ==========================================
// ENUMS FOR TEACHER MARKETPLACE
// ==========================================

enum MarketplaceProductStatus {
  DRAFT
  PENDING_REVIEW
  REVISION_REQUIRED
  APPROVED
  REJECTED
}

enum MarketplacePurchaseStatus {
  PENDING
  RELEASED
  REFUNDED
  CANCELLED
}

enum MarketplaceProductType {
  COURSE
  EBOOK
  PDF
  FLASHCARDS
  MENTORING
  BUNDLE
}

enum TeacherApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewAction {
  SUBMIT
  APPROVE
  REJECT
  REQUEST_REVISION
}

// ==========================================
// TEACHER MARKETPLACE DOMAIN MODELS
// ==========================================

model MarketplaceSettings {
  id                         String   @id @default("default")
  jtToBrlConversionRate      Decimal  @default(0.0100)
  defaultPlatformCommission  Decimal  @default(10.00)
  escrowDays                 Int      @default(7)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model MarketplaceSettingsHistory {
  id         String   @id @default(uuid())
  adminId    String
  adminName  String
  adminEmail String
  reason     String
  oldValue   Json
  newValue   Json
  createdAt  DateTime @default(now())
}

model TeacherProfile {
  id             String               @id @default(uuid())
  userId         String               @unique
  bio            String
  academy        String
  approved       Boolean              @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  // Relationships
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  products       MarketplaceProduct[]

  @@index([approved])
}

model MarketplaceTeacherApplication {
  id          String                   @id @default(uuid())
  userId      String
  bio         String
  academy     String
  experience  String
  status      TeacherApplicationStatus @default(PENDING)
  adminNotes  String?
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  // Relationships
  user      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents MarketplaceTeacherDocument[]

  @@index([userId])
  @@index([status])
}

model MarketplaceTeacherDocument {
  id              String                        @id @default(uuid())
  applicationId   String
  documentType    String                        // e.g., "ID_CARD", "BLACK_BELT_DIPLOMA", "FEDERATION_CARD"
  fileUrl         String
  fileName        String?
  fileSize        Int?
  status          String                        @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  verifiedAt      DateTime?
  verifiedBy      String?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  // Relationships
  application     MarketplaceTeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model MarketplaceCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  products    MarketplaceProduct[]

  @@index([isActive])
}

model MarketplaceProduct {
  id              String                   @id @default(uuid())
  profileId       String
  categoryId      String
  title           String
  description     String
  priceJT         Int
  type            MarketplaceProductType
  status          MarketplaceProductStatus @default(DRAFT)
  rating          Decimal                  @default(0.0)
  salesCount      Int                      @default(0)
  isArchived      Boolean                  @default(false)
  archivedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  // Relationships
  teacherProfile TeacherProfile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category       MarketplaceCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  versions       MarketplaceProductVersion[]
  lessons        MarketplaceLesson[]
  files          MarketplaceFile[]
  purchases      MarketplacePurchase[]
  enrollments    MarketplaceEnrollment[]
  reviews        MarketplaceReview[]
  reviewHistories ProductReviewHistory[]

  @@index([profileId])
  @@index([categoryId])
  @@index([status])
  @@index([type])
  @@index([isArchived])
}

model MarketplaceProductVersion {
  id        String   @id @default(uuid())
  productId String
  version   Int
  snapshot  Json
  createdAt DateTime @default(now())

  // Relationships
  product   MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model MarketplaceLesson {
  id          String   @id @default(uuid())
  productId   String
  title       String
  description String?
  videoUrl    String?
  orderIndex  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  product   MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  files     MarketplaceFile[]

  @@index([productId])
  @@index([orderIndex])
}

model MarketplaceFile {
  id          String   @id @default(uuid())
  productId   String?
  lessonId    String?
  name        String
  fileUrl     String
  fileSize    Int?
  createdAt   DateTime @default(now())

  // Relationships
  product   MarketplaceProduct? @relation(fields: [productId], references: [id], onDelete: Cascade)
  lesson    MarketplaceLesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([lessonId])
}

model MarketplacePurchase {
  id                    String                    @id @default(uuid())
  buyerId               String
  productId             String
  priceSpentJT          Int
  conversionRateUsed    Decimal
  totalEquivalentBRL    Decimal
  platformCommissionBRL Decimal
  teacherNetBRL         Decimal
  status                MarketplacePurchaseStatus @default(PENDING)
  escrowDays            Int                       @default(7)
  releaseDate           DateTime
  riskScore             Int                       @default(0)
  fraudFlag             Boolean                   @default(false)
  ipAddress             String?
  fingerprint           String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  // Relationships
  buyer     User               @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  product   MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([buyerId])
  @@index([productId])
  @@index([status])
  @@index([releaseDate])
}

model MarketplaceEnrollment {
  id        String   @id @default(uuid())
  userId    String
  productId String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([active])
}

model MarketplaceReview {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model ProductReviewHistory {
  id        String       @id @default(uuid())
  productId String
  action    ReviewAction
  actorId   String
  notes     String?
  createdAt DateTime     @default(now())

  // Relationships
  product   MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ==========================================
// ACADEMY AND TEAM HIERARCHY SYSTEM
// ==========================================

model GlobalTeam {
  id                     String               @id @default(uuid())
  name                   String
  slug                   String               @unique
  logo                   String?
  countryOrigin          String?
  website                String?
  instagram              String?
  description            String?
  foundedYear            Int?
  totalMembers           Int                  @default(0)
  totalPoints            Int                  @default(0)
  verified               Boolean              @default(false)
  founders               String?
  headquartersInstructor String?
  headquartersCountry    String?
  headquartersState      String?
  headquartersCity       String?
  verifiedOfficial       Boolean              @default(false)
  deletedAt              DateTime?
  deletedBy              String?
  deletionReason         String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  branches               AcademyBranch[]
  users                  User[]
  affiliationHistories   AffiliationHistory[]
}

model AcademyBranch {
  id                   String               @id @default(uuid())
  globalTeamId         String
  name                 String
  slug                 String               @unique
  country              String?
  state                String?
  city                 String?
  address              String?
  latitude             Float?
  longitude            Float?
  headProfessor        String?
  logo                 String?
  membersCount         Int                  @default(0)
  points               Int                  @default(0)
  verified             Boolean              @default(false)
  externalId           String?
  source               String?
  lastSyncAt           DateTime?
  verifiedExternally   Boolean              @default(false)
  deletedAt            DateTime?
  deletedBy            String?
  deletionReason       String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  globalTeam           GlobalTeam           @relation(fields: [globalTeamId], references: [id], onDelete: Cascade)
  users                User[]
  affiliationHistories AffiliationHistory[]

  @@index([globalTeamId])
}

model IndependentAcademy {
  id                   String               @id @default(uuid())
  name                 String
  country              String?
  state                String?
  city                 String?
  address              String?
  headProfessor        String?
  logo                 String?
  membersCount         Int                  @default(0)
  points               Int                  @default(0)
  verified             Boolean              @default(false)
  externalId           String?
  source               String?
  lastSyncAt           DateTime?
  verifiedExternally   Boolean              @default(false)
  deletedAt            DateTime?
  deletedBy            String?
  deletionReason       String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  users                User[]
  affiliationHistories AffiliationHistory[]
}

// ==========================================
// GEOGRAPHY GLOBAL SYSTEM (FASE 5)
// ==========================================

model Country {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique // e.g. "BR", "US"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states    State[]
}

model State {
  id        String   @id @default(uuid())
  name      String
  code      String   // e.g. "SP", "RJ"
  countryId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities    City[]

  @@unique([countryId, code])
  @@index([countryId])
}

model City {
  id        String   @id @default(uuid())
  name      String
  stateId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state         State          @relation(fields: [stateId], references: [id], onDelete: Cascade)
  neighborhoods Neighborhood[]

  @@index([stateId])
}

model Neighborhood {
  id        String   @id @default(uuid())
  name      String
  cityId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId])
}

// ==========================================
// GOVERNANCE OF AFFILIATIONS SYSTEM (FASE 7)
// ==========================================

enum AffiliationStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
  TRANSFERRED
  INACTIVE
}

model AffiliationHistory {
  id                   String            @id @default(uuid())
  userId               String
  globalTeamId         String?
  branchId             String?
  independentAcademyId String?
  status               AffiliationStatus @default(PENDING)
  startDate            DateTime          @default(now())
  endDate              DateTime?
  changeReason         String?
  performedBy          String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  globalTeam           GlobalTeam?       @relation(fields: [globalTeamId], references: [id], onDelete: SetNull)
  branch               AcademyBranch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  independentAcademy   IndependentAcademy? @relation(fields: [independentAcademyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([globalTeamId])
  @@index([branchId])
  @@index([independentAcademyId])
}

// ==========================================
// GOVERNANCE AUDITING (FASE 8)
// ==========================================

model GovernanceAuditLog {
  id            String   @id @default(uuid())
  userId        String
  userRole      String
  action        String
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  notes         String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================
// COURSE MODULES & PROGRESS (MÓDULOS DO CURSO)
// ==========================================

model CourseModule {
  id             String         @id @default(cuid())
  title          String
  slug           String         @default("")
  description    String
  thumbnail      String
  coverImage     String         @default("")
  order          Int
  estimatedHours Float          @default(0)
  passingScore   Int            @default(70)
  version        Int            @default(1)
  isPublished    Boolean        @default(true)
  isArchived     Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdBy      String         @default("")
  updatedBy      String         @default("")
  lessons        CourseLesson[]
  exams          CourseExam[]
}

model CourseLesson {
  id                  String                 @id @default(cuid())
  moduleId            String
  title               String
  slug                String                 @default("")
  description         String
  thumbnail           String
  videoType           String                 @default("upload") // youtube, vimeo, upload, etc.
  videoSource         String                 @default("")
  audioType           String                 @default("upload")
  audioSource         String                 @default("")
  lessonContent       String                 @default("")
  transcript          String                 @default("")
  duration            String                 @default("0:00")
  xpReward            Int                    @default(100)
  order               Int
  version             Int                    @default(1)
  isPublished         Boolean                @default(true)
  isArchived          Boolean                @default(false)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  module              CourseModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  flashcards          CourseFlashcard[]
  quizzes             CourseQuizQuestion[]
  progressRecords     CourseLessonProgress[]

  @@index([moduleId])
}

model CourseFlashcard {
  id        String       @id @default(cuid())
  lessonId  String
  frontText String
  backText  String
  audioUrl  String       @default("")
  imageUrl  String       @default("")
  order     Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  lesson    CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model CourseQuizQuestion {
  id            String       @id @default(cuid())
  lessonId      String
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  explanation   String       @default("")
  points        Int          @default(10)
  order         Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  lesson        CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model CourseLessonProgress {
  id                  String       @id @default(cuid())
  userId              String
  lessonId            String
  videoCompleted      Boolean      @default(false)
  audioCompleted      Boolean      @default(false)
  textCompleted       Boolean      @default(false)
  quizCompleted       Boolean      @default(false)
  flashcardsCompleted Boolean      @default(false)
  completed           Boolean      @default(false)
  completedAt         DateTime?
  lesson              CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lessonId])
}

model CourseExam {
  id           String               @id @default(cuid())
  moduleId     String
  title        String
  description  String
  passingScore Int                  @default(70)
  version      Int                  @default(1)
  isPublished  Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  module       CourseModule         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions    CourseExamQuestion[]

  @@index([moduleId])
}

model CourseExamQuestion {
  id            String     @id @default(cuid())
  examId        String
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  points        Int        @default(10)
  order         Int
  exam          CourseExam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}

model CourseExamAttempt {
  id            String    @id @default(cuid())
  userId        String
  moduleId      String
  score         Int
  passed        Boolean
  attemptedAt   DateTime  @default(now())
  nextAttemptAt DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([moduleId])
}

model CourseModuleProgress {
  id               String    @id @default(cuid())
  userId           String
  moduleId         String
  xp               Int       @default(0)
  completed        Boolean   @default(false)
  completedAt      DateTime?
  studyTimeSeconds Int       @default(0)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}



