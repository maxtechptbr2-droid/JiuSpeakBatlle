datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS FOR GAMIFIED BJJ PLATFORM
// ==========================================

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}























// ==========================================
// CORE DOMAIN MODELS
// ==========================================

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  name              String
  password          String
  isEmailVerified   Boolean      @default(false)
  verificationToken String?
  resetToken        String?
  resetTokenExpires DateTime?
  refreshToken      String?
  avatar            String?
  role              String     @default("ATHLETE")
  isAdminApproved   Boolean      @default(true)
  isSuspended       Boolean      @default(false)
  isBanned          Boolean      @default(false)
  belt              String     @default("WHITE")
  stripes           Int          @default(0)
  xp                Int          @default(0)
  level             Int          @default(1)
  elo               Int          @default(1000)
  bio               String?      @default("")
  city              String?      @default("")
  country           String?      @default("")
  nativeLanguage    String?      @default("")
  learningGoal      String?      @default("")
  profilePhoto      String?      @default("")
  coverPhoto        String?      @default("")
  instagram         String?      @default("")
  youtube           String?      @default("")
  facebook          String?      @default("")
  website           String?      @default("")
  birthDate         DateTime?
  phone             String?
  englishLevel      String?
  spanishLevel      String?
  frenchLevel       String?
  onboardingDone    Boolean      @default(false)
  lastLoginAt       DateTime?
  username          String?      @unique
  beltRank          String?
  favoriteTechnique String?
  favoriteAthlete   String?
  privacyLevel      String?      @default("public")
  followersCount    Int          @default(0)
  followingCount    Int          @default(0)
  themeColor        String?
  avatarFrame       String?
  isVerified        Boolean      @default(false)
  vipActive         Boolean      @default(false)
  masterActive      Boolean      @default(false)
  subscriptionType  String?      @default("FREE")
  subscriptionUntil DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relationships
  wallet                    Wallet?
  bankAccounts              BankAccount[]
  subscriptions             Subscription[]
  payments                  Payment[]
  userAchievements          UserAchievement[]
  inventory                 Inventory?
  storeSales                StoreSale[]
  marketplaceSalesAsBuyer   MarketplaceSale[]
  marketplaceItemsForSale   MarketplaceItem[]
  pvpMatchesAsChallenger    PvpMatch[]            @relation("ChallengerMatches")
  pvpMatchesAsDefender      PvpMatch[]            @relation("DefenderMatches")
  pvpMatchesAsWinner        PvpMatch[]            @relation("WinnerMatches")
  pvpAnswers                PvpAnswer[]
  rank                      Rank?
  notifications             Notification[]
  auditLogs                 AuditLog[]
  socialPosts               SocialPost[]
  comments                  Comment[]
  likes                     Like[]
  followers                 Follower[]            @relation("UserFollowers")
  following                 Follower[]            @relation("UserFollowing")
  refreshTokens             RefreshToken[]
  academyProgress           AcademyProgress[]

  @@index([belt])
  @@index([level])
  @@index([elo])
}

model Wallet {
  id               String   @id @default(uuid())
  userId           String   @unique
  balanceKC        Int      @default(0) // Kimono Coins (Platform virtual coin)
  balanceBRL       Decimal  @default(0.00)  // Instructor/Saas real monetary balance
  balanceAvailable Decimal  @default(0.00)  // Saldo disponível para saque
  balancePending   Decimal  @default(0.00)  // Saldo pendente (vendas aprovadas)
  totalEarned      Decimal  @default(0.00)  // Total ganho acumulado
  totalWithdrawn   Decimal  @default(0.00)  // Total sacado acumulado
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relationships
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  withdrawals  Withdrawal[]
}

model Transaction {
  id          String            @id @default(uuid())
  walletId    String
  amountKC    Int?
  amountBRL   Decimal?          
  type        String
  status      String @default("PENDING")
  description String?
  referenceId String?           // Tracking code linked to Purchases (StoreSale, P2PSale ID)
  createdAt   DateTime          @default(now())

  // Relationships
  wallet     Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  pixPayment PixPayment?

  @@index([walletId, status])
  @@index([type])
  @@index([referenceId])
  @@index([createdAt])
}

model PixPayment {
  id              String        @id @default(uuid())
  transactionId   String        @unique
  qrCode          String        
  qrCodeCopyPaste String        
  txid            String        @unique
  amountBRL       Decimal       
  status          String @default("PENDING")
  createdAt       DateTime      @default(now())
  expiresAt       DateTime
  paidAt          DateTime?

  // Relationships
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
}

model BankAccount {
  id            String   @id @default(uuid())
  userId        String
  bankName      String
  agency        String
  accountNumber String
  accountType   String   // Corrente, Poupança, etc.
  pixKey        String?
  pixKeyType    String?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relationships
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawals Withdrawal[]

  @@index([userId])
}

model Withdrawal {
  id            String           @id @default(uuid())
  walletId      String
  bankAccountId String
  amountBRL     Decimal          
  status        String @default("PENDING")
  pixKey        String
  pixKeyType    String
  notes         String?          
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relationships
  wallet      Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  @@index([walletId])
  @@index([bankAccountId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

model WithdrawalAudit {
  id           String   @id @default(uuid())
  withdrawalId String
  action       String   // REQUEST, BLOCKED_BALANCE, ADMIN_APPROVE, PIX_DISPATCHED, ADMIN_REJECT, RESTORED_BALANCE
  actorId      String?
  actorName    String?
  details      String   
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([withdrawalId])
  @@index([actorId])
  @@index([createdAt])
}

model Subscription {
  id              String             @id @default(uuid())
  userId          String
  planId          String
  planType        String?            // PRO, MASTER, etc.
  provider        String?            // STRIPE, MERCADOPAGO, FREE
  externalId      String?            // Stripe subscription ID or checkout session ID
  amount          Decimal?           
  status          String @default("ACTIVE")
  startDate       DateTime           @default(now())
  endDate         DateTime
  canceledAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // Relationships
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments SubscriptionPayment[]

  @@index([userId])
  @@index([planId])
  @@index([userId, status])
  @@index([status, endDate])
}

model Payment {
  id             String   @id @default(uuid())
  userId         String
  subscriptionId String
  provider       String
  status         String
  amount         Decimal  
  currency       String
  transactionId  String   @unique
  payerEmail     String?
  payerName      String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subscriptionId])
  @@index([transactionId])
}

model PaymentLog {
  id            String   @id @default(uuid())
  provider      String?
  transactionId String?
  status        String?
  amount        Decimal? 
  payerEmail    String?
  payerName     String?
  createdAt     DateTime @default(now())
}

model WebhookLog {
  id            String   @id @default(uuid())
  provider      String?
  transactionId String?
  status        String?
  amount        Decimal? 
  payerEmail    String?
  payerName     String?
  payload       String?  
  createdAt     DateTime @default(now())
}

model Plan {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  
  priceBRL    Decimal  
  interval    String   // monthly, yearly
  features    String[]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Relationships
  subscriptions Subscription[]

  @@index([active])
}

model SubscriptionPayment {
  id              String        @id @default(uuid())
  subscriptionId  String
  amountBRL       Decimal       
  status          String @default("PENDING")
  txid            String?       @unique
  qrCode          String?       
  qrCodeCopyPaste String?       
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relationships
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@index([subscriptionId, status])
}

model Achievement {
  id              String   @id @default(uuid())
  title           String   @unique
  description     String   
  xpReward        Int
  coinReward      Int
  requirementCode String   @unique // Internal programmatic check name (e.g., 'LessonsCompleted')
  targetValue     Int      // Numerical threshold to lock/unlock
  imageUrl        String?
  createdAt       DateTime @default(now())

  // Relationships
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String    @id @default(uuid())
  userId        String
  achievementId String
  currentValue  Int       @default(0)
  isUnlocked    Boolean   @default(false)
  unlockedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([achievementId])
  @@index([isUnlocked])
}

model Inventory {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items InventoryItem[]
}

model InventoryItem {
  id          String   @id @default(uuid())
  inventoryId String
  productId   String?  // References official catalog product, nullable if custom listing/drop
  name        String
  description String?  
  rarity      Rarity   @default(COMMON)
  imageUrl    String?
  isEquipped  Boolean  @default(false)
  acquiredAt  DateTime @default(now())

  // Relationships
  inventory       Inventory        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  product         StoreProduct?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  marketplaceItem MarketplaceItem?

  @@index([inventoryId])
  @@index([productId])
  @@index([inventoryId, isEquipped])
}

model StoreProduct {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   
  priceKC     Int
  priceBRL    Decimal?  // Optional fiat pricing for premium cosmetics
  category    String   // GI, BELT_STRIPE, AVATAR, TITLE_TAG
  rarity      Rarity   @default(COMMON)
  imageUrl    String?
  stock       Int?     // Null means infinite stock
  active      Boolean  @default(true)
  isPromo     Boolean  @default(false)
  promoPriceKC Int?
  isBundle    Boolean  @default(false)
  isSeasonal  Boolean  @default(false)
  isExclusive Boolean  @default(false)
  releaseDate  DateTime? // Programmed launch date/time
  promoEndDate DateTime? // Programmed promotion end date/time
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  storeSales     StoreSale[]
  inventoryItems InventoryItem[]

  @@index([category])
  @@index([active, category])
}

model StoreSale {
  id          String   @id @default(uuid())
  productId   String
  buyerId     String
  pricePaidKC Int?
  pricePaidBRL Decimal? 
  createdAt   DateTime @default(now())

  // Relationships
  product StoreProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  buyer   User         @relation(fields: [buyerId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([buyerId])
}

model MarketplaceItem {
  id              String   @id @default(uuid())
  inventoryItemId String   @unique
  sellerId        String
  priceKC         Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  inventoryItem InventoryItem    @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  seller        User             @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  sale          MarketplaceSale?

  @@index([sellerId])
  @@index([active])
  @@index([active, priceKC])
  @@index([active, createdAt])
}

model MarketplaceSale {
  id                String   @id @default(uuid())
  marketplaceItemId String   @unique
  buyerId           String
  pricePaidKC       Int
  feePaidKC         Int      // Platform fee collected from transit
  createdAt         DateTime @default(now())

  // Relationships
  marketplaceItem MarketplaceItem @relation(fields: [marketplaceItemId], references: [id], onDelete: Cascade)
  buyer           User            @relation(fields: [buyerId], references: [id], onDelete: Restrict)

  @@index([buyerId])
}

model PvpMatch {
  id                  String         @id @default(uuid())
  challengerId        String
  defenderId          String
  winnerId            String?
  challengerScore     Int            @default(0)
  defenderScore       Int            @default(0)
  xpReward            Int            @default(0)
  coinReward          Int            @default(0)
  eloChangeChallenger Int?
  eloChangeDefender   Int?
  status              String @default("PENDING")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relationships
  challenger User       @relation("ChallengerMatches", fields: [challengerId], references: [id], onDelete: Cascade)
  defender   User       @relation("DefenderMatches", fields: [defenderId], references: [id], onDelete: Cascade)
  winner     User?      @relation("WinnerMatches", fields: [winnerId], references: [id], onDelete: SetNull)
  rounds     PvpRound[]

  @@index([challengerId])
  @@index([defenderId])
  @@index([winnerId])
  @@index([status])
}

model PvpRound {
  id          String   @id @default(uuid())
  matchId     String
  roundNumber Int
  questionId  String
  createdAt   DateTime @default(now())

  // Relationships
  match    PvpMatch    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  question PvpQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answers  PvpAnswer[]

  @@unique([matchId, roundNumber])
  @@index([questionId])
}

model PvpQuestion {
  id            String   @id @default(uuid())
  text          String   
  category      String
  difficulty    String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String   // "A", "B", "C" or "D"
  explanation   String?  
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  // Relationships
  pvpRounds   PvpRound[]
  pvpAnswers  PvpAnswer[]

  @@index([category])
  @@index([category, isActive])
}

model PvpAnswer {
  id             String   @id @default(uuid())
  roundId        String
  userId         String
  questionId     String
  selectedOption String
  isCorrect      Boolean
  responseTimeMs Int
  createdAt      DateTime @default(now())

  // Relationships
  round    PvpRound    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  question PvpQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
  @@index([userId])
  @@index([questionId])
}

model Rank {
  id             String   @id @default(uuid())
  userId         String   @unique
  globalPosition Int?
  beltPosition   Int?
  weeklyRank     String   @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM, CHAMPION
  points         Int      @default(0)
  updatedAt      DateTime @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([points])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  content   String           
  type      String @default("SYSTEM")
  isRead    Boolean          @default(false)
  linkTo    String?          // Redirection link within the platform
  createdAt DateTime         @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model AuditLog {
  id          String          @id @default(uuid())
  actorId     String?
  action      String
  description String          
  ipAddress   String?
  userAgent   String?
  amountBRL   Decimal?        
  amountKC    Int?
  createdAt   DateTime        @default(now())

  // Relationships
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model SocialPost {
  id           String   @id @default(uuid())
  authorId     String
  content      String   
  category     String   // "#treinos", "#duvidas-posicoes", "#memes-tatame", "#campeonatos"
  imageUrl     String?
  upvotesCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]

  @@index([authorId])
  @@index([category])
  @@index([createdAt])
  @@index([category, createdAt])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  post   SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  // Relationships
  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Follower {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  // Relationships
  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  issuedAt   DateTime @default(now())
  isRevoked  Boolean  @default(false)
  ipAddress  String?
  userAgent  String?
  replacedBy String?  // Stores the newer token in the rotation chain

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ipAddress String?
  success   Boolean
  timestamp DateTime @default(now())

  @@index([email])
  @@index([timestamp])
  @@index([email, success, timestamp])
}

model AcademyModule {
  id          String   @id @default(cuid())
  title       String
  description String
  beltLevel   String
  orderIndex  Int
  active      Boolean  @default(true)
  lessons     AcademyLesson[]
}

model AcademyLesson {
  id          String   @id @default(cuid())
  moduleId    String
  title       String
  description String
  youtubeUrl  String
  xpReward    Int      @default(100)
  orderIndex  Int

  module AcademyModule @relation(fields: [moduleId], references: [id])
}

model AcademyProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id])
}


